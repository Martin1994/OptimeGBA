<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>OptimeGBASdl3.Program</StartupObject>
    <ApplicationIcon>../../icon.ico</ApplicationIcon>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.302.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.5" />
    <ProjectReference Include="../emulator/OptimeGBA-Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="resources/animation/*.raw" />
    <EmbeddedResource Include="resources/no-intro.dat" />
  </ItemGroup>
</Project>
